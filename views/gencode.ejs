<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>AI Grocery Generator</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 30px;
      background: #f5f5f5;
    }

    .container {
      background: rgb(255, 255, 255);
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);
      width: 400px;
      margin: auto;
    }

    input,
    button {
      width: 100%;
      padding: 10px;
      margin-top: 10px;
      border: 1px solid #ccc;
      border-radius: 5px;
      font-size: 16px;
    }

    button {
      background-color: #540303;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background-color: #a10909;
    }

    #status {
      margin-top: 15px;
      font-weight: bold;
    }

    /* Loader Cube Spinner Styles */
    .spinner {
      width: 70.4px;
      height: 70.4px;
      --clr: rgb(136, 6, 6);               /* Dark red border */
      --clr-alpha: rgba(136, 6, 6, 0.1);   /* Transparent face fill */
      animation: spinner 1.6s infinite ease;
      transform-style: preserve-3d;
      position: relative;
    }

    .spinner > div {
      background-color: var(--clr-alpha);
      height: 100%;
      position: absolute;
      width: 100%;
      border: 3.5px solid var(--clr);
    }

    .spinner div:nth-of-type(1) { transform: translateZ(-35.2px) rotateY(180deg); }
    .spinner div:nth-of-type(2) { transform: rotateY(-270deg) translateX(50%); transform-origin: top right; }
    .spinner div:nth-of-type(3) { transform: rotateY(270deg) translateX(-50%); transform-origin: center left; }
    .spinner div:nth-of-type(4) { transform: rotateX(90deg) translateY(-50%); transform-origin: top center; }
    .spinner div:nth-of-type(5) { transform: rotateX(-90deg) translateY(50%); transform-origin: bottom center; }
    .spinner div:nth-of-type(6) { transform: translateZ(35.2px); }

    @keyframes spinner {
      0%   { transform: rotate(45deg) rotateX(-25deg) rotateY(25deg); }
      50%  { transform: rotate(45deg) rotateX(-385deg) rotateY(25deg); }
      100% { transform: rotate(45deg) rotateX(-385deg) rotateY(385deg); }
    }
  </style>
</head>

<body class="min-h-screen bg-gradient-to-br from-rose-50 via-white to-orange-50 flex flex-col items-center justify-center px-4 py-10 font-sans">

  <!-- Header -->
  <h2 class="text-9xl relative md:text-8xl font-extrabold text-red-900 mb-10 text-center">
    AI-Powered <br> Cart
    <img class="absolute top-23 left-[70%] right-1/2 w-32 h-32" src="/images/finallogo.png" alt="">
  </h2>

  <!-- Input Section -->
  <div class="w-full max-w-md bg-white/80 backdrop-blur-md p-6 rounded-2xl shadow-lg border border-amber-100 text-center space-y-4">
    <input 
      type="text" 
      id="dish" 
      placeholder="Enter Dish Name"
      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 text-gray-800"
    />

    <button 
      onclick="generateAndAdd()"
      class="w-full bg-amber-600 hover:bg-amber-700 text-white font-semibold py-2 rounded-lg transition duration-200"
    >
      Generate Cart
    </button>

    <div id="status" class="text-sm text-gray-600 pt-2"></div>
  </div>

  <!-- Loader -->
  <div id="loader" class="hidden fixed inset-0 bg-white bg-opacity-70 z-50 flex items-center justify-center">
    <div class="spinner">
      <div></div><div></div><div></div><div></div><div></div><div></div>
    </div>
  </div>

  <script>
    async function generateAndAdd() {
      const dish = document.getElementById('dish').value.trim();
      const statusDiv = document.getElementById('status');
      const loader = document.getElementById('loader');

      if (!dish) {
        statusDiv.innerText = "Please enter a dish name!";
        return;
      }

      try {
        statusDiv.innerText = "";
        loader.classList.remove("hidden");

        const gencodeResponse = await fetch('/ai/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dish })
        });

        const gencodeData = await gencodeResponse.json();

        if (!gencodeResponse.ok) {
          throw new Error(gencodeData.message || "Error generating ingredients");
        }

        const ingredients = gencodeData.ingredients;

        if (!ingredients || ingredients.length === 0) {
          loader.classList.add("hidden");
          statusDiv.innerText = "No ingredients found for the given dish.";
          return;
        }

        const addCartResponse = await fetch('/cart/add-generated', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ingredients })
        });

        loader.classList.add("hidden");
        statusDiv.innerText = "Ingredients added to cart successfully! 🎉";

        setTimeout(() => {
          window.location.href = "/cart";
        }, 1000);
      } catch (error) {
        loader.classList.add("hidden");
        console.error(error);
        statusDiv.innerText = " ";
        setTimeout(() => {
          window.location.href = "/cart";
        }, 1000);
      }
    }
  </script>
</body>
</html>
