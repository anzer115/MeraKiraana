<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Order Summary | MeraKiraana</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
</head>
<body class="bg-gradient-to-b from-red-50 via-white to-red-100 text-gray-900 font-sans min-h-screen">

  <div class="max-w-4xl mx-auto my-12 p-8 bg-white rounded-3xl shadow-2xl border border-red-200 animate-fade-in">
    
    <h1 class="text-5xl font-extrabold text-red-800 mb-8 text-center tracking-tight drop-shadow-md">
      🎉 Order Confirmed!
    </h1>

    <p class="text-center text-lg text-gray-600 mb-10">Thank you for shopping with <span class="font-semibold text-red-800">MeraKiraana</span>. Here's your summary:</p>

    <!-- Items List -->
    <section class="mb-10">
      <h2 class="text-2xl font-semibold text-gray-800 mb-5 flex items-center gap-2">
        🛒 Your Items
      </h2>
      <ul class="space-y-4">
        <% products.forEach(p => { %>
          <li class="flex justify-between items-center bg-red-50 border border-red-200 px-5 py-3 rounded-xl shadow-sm hover:shadow-md transition-all duration-200">
            <span class="text-lg font-medium"><%= p.name %></span>
            <span class="text-xl font-bold text-red-700">₹<%= p.price %></span>
          </li>
        <% }) %>
      </ul>
    </section>

    <!-- Total -->
    <div class="flex justify-end items-center mb-12 border-t border-dashed border-red-300 pt-6">
      <h3 class="text-2xl font-bold text-red-900">
        Total: <span class="text-red-700">₹<%= totalprice %></span>
      </h3>
    </div>

<!-- AI Recipe -->
<section class="mb-16">
  <div class="bg-gradient-to-br from-amber-50 via-white to-rose-50 rounded-3xl shadow-xl border border-gray-200 p-8 relative overflow-hidden group">

    <!-- Decorative Background Icon -->
    <div class="absolute -top-5 -left-5 text-[4rem] opacity-10 rotate-12 group-hover:opacity-20 transition">
      🍲
    </div>

    <h2 class="text-3xl font-bold text-amber-700 mb-2 tracking-tight">AI-Generated Recipe</h2>
    <p class="text-gray-600 italic mb-6 text-lg">A delicious creation crafted with the power of AI.</p>

    <!-- Recipe Box -->
    <div class="bg-white/90 backdrop-blur-md p-6 rounded-xl shadow-inner border border-gray-100 text-gray-900 leading-relaxed font-serif text-[1.075rem] space-y-5 transition-all duration-300 group-hover:scale-[1.01]">
      <%- recipeHtml %>
    </div>
  </div>
</section>





    <!-- Back to Home Button -->
    <div class="text-center">
      <a href="/products" class="inline-block bg-red-800 hover:bg-red-600 focus:ring-4 focus:ring-red-300 text-white font-semibold py-3 px-8 rounded-full transition duration-300 shadow-md hover:scale-105 transform">
         Back to Home
      </a>
    </div>

  </div>

  <style>
    @keyframes fade-in {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fade-in 0.7s ease-out both;
    }
  </style>
</body>
</html>
